# chezmoi:modify-template
{{- $current := .chezmoi.stdin -}}
{{- $bootstrapFile := "# managed by chezmoi: settingZsh public baseline\nif [ -f \"$HOME/.config/settingzsh/init.zsh\" ]; then\n  source \"$HOME/.config/settingzsh/init.zsh\"\nfi\n" -}}
{{- $bootstrapBlock := "# >>> settingZsh bootstrap >>>\n[ -f \"$HOME/.config/settingzsh/init.zsh\" ] && source \"$HOME/.config/settingzsh/init.zsh\"\n# <<< settingZsh bootstrap <<<\n" -}}
{{- $stripped := replaceAllRegex `(?ms)(?:\n)?# >>> settingZsh bootstrap >>>\n.*?# <<< settingZsh bootstrap <<<\n?` `` $current -}}
{{- if eq (trim $current) "" -}}
{{ $bootstrapFile -}}
{{- else if eq (trim $current) (trim $bootstrapFile) -}}
{{ $bootstrapFile -}}
{{- else if eq (trim $stripped) "" -}}
{{ $bootstrapBlock -}}
{{- else -}}
{{- if hasSuffix $stripped "\n" -}}
{{ $stripped -}}
{{- else -}}
{{ printf "%s\n" $stripped -}}
{{- end }}
{{ $bootstrapBlock -}}
{{- end -}}
