{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

if ! command -v git >/dev/null 2>&1; then
  echo "[settingzsh] git unavailable, skip zinit bootstrap"
  exit 0
fi

DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
ZINIT_HOME="$DATA_HOME/zinit/zinit.git"

mkdir -p "$(dirname "$ZINIT_HOME")"

if [ -d "$ZINIT_HOME/.git" ]; then
  git -C "$ZINIT_HOME" pull --ff-only || true
  exit 0
fi

if [ -e "$ZINIT_HOME" ]; then
  echo "[settingzsh] zinit path already exists and is not a git repo, skip bootstrap: $ZINIT_HOME"
  exit 0
fi

if git clone --depth 1 https://github.com/zdharma-continuum/zinit.git "$ZINIT_HOME"; then
  echo "[settingzsh] zinit installed; managed plugins will bootstrap on next interactive zsh startup"
fi
{{- end -}}
