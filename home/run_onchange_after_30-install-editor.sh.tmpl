{{- if ne .chezmoi.os "windows" -}}
#!/usr/bin/env bash
set -euo pipefail

OS="{{ .chezmoi.os }}"
FEATURE_EDITOR_DEFAULT="{{ if (get (get . "features") "editor") }}true{{ else }}false{{ end }}"
FEATURE_EDITOR="${SETTINGZSH_FEATURE_EDITOR:-$FEATURE_EDITOR_DEFAULT}"
NVM_VERSION="v0.40.1"
RIPGREP_URL_X86_64="{{ index . "artifacts" "ripgrep" "linux" "x86_64" }}"
RIPGREP_URL_ARM64="{{ index . "artifacts" "ripgrep" "linux" "arm64" }}"
FD_URL_X86_64="{{ index . "artifacts" "fd" "linux" "x86_64" }}"
FD_URL_ARM64="{{ index . "artifacts" "fd" "linux" "arm64" }}"
NVIM_URL_X86_64="{{ index . "artifacts" "neovim" "linux" "x86_64" }}"
NVIM_URL_ARM64="{{ index . "artifacts" "neovim" "linux" "arm64" }}"
LAZYGIT_URL_X86_64="{{ index . "artifacts" "lazygit" "linux" "x86_64" }}"
LAZYGIT_URL_ARM64="{{ index . "artifacts" "lazygit" "linux" "arm64" }}"

detect_arch() {
  case "$(uname -m)" in
    x86_64|amd64) printf '%s\n' "x86_64" ;;
    aarch64|arm64) printf '%s\n' "arm64" ;;
    *) printf '%s\n' "unsupported" ;;
  esac
}

select_arch_value() {
  local x86_64_value="$1"
  local arm64_value="$2"

  case "$(detect_arch)" in
    x86_64) printf '%s\n' "$x86_64_value" ;;
    arm64) printf '%s\n' "$arm64_value" ;;
    unsupported) return 1 ;;
    *) return 1 ;;
  esac
}

if [[ ! "$FEATURE_EDITOR" =~ ^(1|true|TRUE|yes|YES|on|ON)$ ]]; then
  echo "[settingzsh] editor feature disabled, skip editor install script"
  exit 0
fi

SOURCE_DIR="${CHEZMOI_SOURCE_DIR:-{{ .chezmoi.sourceDir }}}"

can_use_sudo() {
  command -v sudo >/dev/null 2>&1 && sudo -n true >/dev/null 2>&1
}

run_apt() {
  if [[ "$(id -u)" -eq 0 ]]; then
    apt "$@"
    return
  fi
  if can_use_sudo; then
    sudo -n apt "$@"
    return
  fi
  return 1
}

install_nvm_and_node_lts() {
  if [ ! -s "$HOME/.nvm/nvm.sh" ]; then
    curl -fsSL "https://raw.githubusercontent.com/nvm-sh/nvm/${NVM_VERSION}/install.sh" | bash
  fi
  export NVM_DIR="$HOME/.nvm"
  if [ -s "$NVM_DIR/nvm.sh" ]; then
    # shellcheck disable=SC1090
    source "$NVM_DIR/nvm.sh"
  fi
  if command -v nvm >/dev/null 2>&1; then
    nvm install --lts
    nvm alias default 'lts/*'
  fi
}

deploy_nvim_config() {
  local source_nvim="$SOURCE_DIR/nvim"
  local target_nvim="$HOME/.config/nvim"

  if [ ! -d "$source_nvim" ]; then
    echo "[settingzsh] nvim source not found: $source_nvim"
    return
  fi

  if [ -d "$target_nvim" ]; then
    mv "$target_nvim" "${target_nvim}.bak"
  fi
  mkdir -p "$HOME/.config"
  cp -R "$source_nvim" "$target_nvim"
}

merge_vimrc() {
  local merge_script="$SOURCE_DIR/lib/config_merge.py"
  local template_vimrc="$SOURCE_DIR/vim/.vimrc"

  if [ ! -f "$merge_script" ] || [ ! -f "$template_vimrc" ]; then
    echo "[settingzsh] vim merge assets not found, skip .vimrc merge"
    return
  fi
  if ! command -v uv >/dev/null 2>&1; then
    echo "[settingzsh] uv not found, skip .vimrc merge"
    return
  fi

  uv run "$merge_script" \
    --target "$HOME/.vimrc" \
    --template "$template_vimrc" \
    --section "vimrc" \
    --type "vim"
}

install_rg_fallback() {
  if command -v rg >/dev/null 2>&1; then
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "[settingzsh] curl unavailable, skip ripgrep fallback"
    return
  fi

  local tmp_dir
  local arch
  local archive_name
  local archive
  local package_name
  local url
  tmp_dir="$(mktemp -d)"
  arch="$(detect_arch)"
  if [ "$arch" = "unsupported" ]; then
    echo "[settingzsh] unsupported architecture for ripgrep fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  if ! url="$(select_arch_value "$RIPGREP_URL_X86_64" "$RIPGREP_URL_ARM64")"; then
    echo "[settingzsh] unsupported architecture for ripgrep fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  archive_name="$(basename "$url")"
  archive="$tmp_dir/$archive_name"
  package_name="${archive_name%.tar.gz}"

  if curl -fsSL "$url" -o "$archive" && tar xzf "$archive" -C "$tmp_dir"; then
    install "$tmp_dir/$package_name/rg" "$HOME/.local/bin/rg"
  else
    echo "[settingzsh] ripgrep fallback install failed"
  fi
  rm -rf "$tmp_dir"
}

install_fd_fallback() {
  if command -v fd >/dev/null 2>&1 || command -v fdfind >/dev/null 2>&1; then
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "[settingzsh] curl unavailable, skip fd fallback"
    return
  fi

  local tmp_dir
  local arch
  local archive_name
  local archive
  local package_name
  local url
  tmp_dir="$(mktemp -d)"
  arch="$(detect_arch)"
  if [ "$arch" = "unsupported" ]; then
    echo "[settingzsh] unsupported architecture for fd fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  if ! url="$(select_arch_value "$FD_URL_X86_64" "$FD_URL_ARM64")"; then
    echo "[settingzsh] unsupported architecture for fd fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  archive_name="$(basename "$url")"
  archive="$tmp_dir/$archive_name"
  package_name="${archive_name%.tar.gz}"

  if curl -fsSL "$url" -o "$archive" && tar xzf "$archive" -C "$tmp_dir"; then
    install "$tmp_dir/$package_name/fd" "$HOME/.local/bin/fd"
  else
    echo "[settingzsh] fd fallback install failed"
  fi
  rm -rf "$tmp_dir"
}

install_nvim_fallback() {
  if command -v nvim >/dev/null 2>&1; then
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "[settingzsh] curl unavailable, skip neovim fallback"
    return
  fi

  local tmp_dir
  local arch
  local archive_name
  local archive
  local extract_dir_name
  local extract_dir_path
  local url
  tmp_dir="$(mktemp -d)"
  arch="$(detect_arch)"
  if [ "$arch" = "unsupported" ]; then
    echo "[settingzsh] unsupported architecture for neovim fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  if ! url="$(select_arch_value "$NVIM_URL_X86_64" "$NVIM_URL_ARM64")"; then
    echo "[settingzsh] unsupported architecture for neovim fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  archive_name="$(basename "$url")"
  archive="$tmp_dir/$archive_name"
  extract_dir_name="${archive_name%.tar.gz}"
  extract_dir_path="$tmp_dir/$extract_dir_name"

  if curl -fsSL "$url" -o "$archive" && tar xzf "$archive" -C "$tmp_dir"; then
    mkdir -p "$HOME/.local"
    cp -R "$extract_dir_path/." "$HOME/.local/"
  else
    echo "[settingzsh] neovim fallback install failed"
  fi
  rm -rf "$tmp_dir"
}

install_lazygit_fallback() {
  if command -v lazygit >/dev/null 2>&1; then
    return
  fi
  if ! command -v curl >/dev/null 2>&1; then
    echo "[settingzsh] curl unavailable, skip lazygit fallback"
    return
  fi

  local tmp_dir
  local arch
  local archive_name
  local archive
  local url
  tmp_dir="$(mktemp -d)"
  arch="$(detect_arch)"
  if [ "$arch" = "unsupported" ]; then
    echo "[settingzsh] unsupported architecture for lazygit fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  if ! url="$(select_arch_value "$LAZYGIT_URL_X86_64" "$LAZYGIT_URL_ARM64")"; then
    echo "[settingzsh] unsupported architecture for lazygit fallback: $arch"
    rm -rf "$tmp_dir"
    return
  fi

  archive_name="$(basename "$url")"
  archive="$tmp_dir/$archive_name"

  if curl -fsSL "$url" -o "$archive" && tar xzf "$archive" -C "$tmp_dir" lazygit; then
    install "$tmp_dir/lazygit" "$HOME/.local/bin/lazygit"
  else
    echo "[settingzsh] lazygit fallback install failed"
  fi
  rm -rf "$tmp_dir"
}

install_darwin_editor() {
  if ! command -v brew >/dev/null 2>&1; then
    echo "[settingzsh] Homebrew not found, skip darwin editor install"
    return
  fi
  brew install vim neovim ripgrep fd lazygit
}

install_linux_editor() {
  if command -v apt >/dev/null 2>&1 && run_apt update -y && run_apt install -y build-essential vim ripgrep fd-find neovim; then
    :
  else
    echo "[settingzsh] non-interactive sudo unavailable, using linux editor fallback installers"
    command -v gcc >/dev/null 2>&1 || echo "[settingzsh] gcc missing (treesitter compile may fail)"
    command -v vim >/dev/null 2>&1 || echo "[settingzsh] vim missing (nvim still supported)"
    install_rg_fallback
    install_fd_fallback
    install_nvim_fallback
    install_lazygit_fallback
  fi
}

case "$OS" in
  darwin) install_darwin_editor ;;
  linux) install_linux_editor ;;
  *)
    echo "[settingzsh] unsupported os for unix editor script: $OS"
    ;;
esac

install_nvm_and_node_lts
merge_vimrc
deploy_nvim_config
{{- end -}}
